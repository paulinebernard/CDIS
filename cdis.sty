% ---- Environnements (définitions, théorèmes, ...) : sobres, sans couleur ----
\usepackage[most]{tcolorbox}
\tcbset{envbase/.style={enhanced,breakable,sharp corners,boxrule=0pt,frame hidden,colback=white,
  left=9pt,right=0pt,top=2pt,bottom=2pt,before skip=1.1\baselineskip,after skip=1.1\baselineskip,
  before upper={\let\footnote\tcbfootnote \setlength{\parindent}{0pt}\setlength{\parskip}{0.5\baselineskip}}}}
% Notes de bas de page dans les environnements : renvoyées en bas de page
% (par défaut tcolorbox les place en fin de boîte, avec des lettres).
\usepackage{etoolbox}
\newcommand{\tcbfnlist}{}
\newcommand{\tcbfootnote}[1]{%
  \stepcounter{footnote}%
  \edef\tcbtmp{\noexpand\footnotetext[\the\value{footnote}]}%
  \expandafter\gappto\expandafter\tcbfnlist\expandafter{\tcbtmp{#1}}%
  \footnotemark[\value{footnote}]}
\newcommand{\tcbflushfn}{\tcbfnlist\gdef\tcbfnlist{}}

\newtcolorbox{definition}[1][]{envbase,borderline west={1.2pt}{0pt}{black},
  before upper={\let\footnote\tcbfootnote \textbf{Définition\ifblank{#1}{}{\ -- #1}.}\par\setlength{\parindent}{0pt}\setlength{\parskip}{0.5\baselineskip}}}
\newtcolorbox{theoreme}[1][]{envbase,borderline west={1.2pt}{0pt}{black},
  before upper={\let\footnote\tcbfootnote \textbf{Théorème\ifblank{#1}{}{\ -- #1}.}\par\setlength{\parindent}{0pt}\setlength{\parskip}{0.5\baselineskip}\itshape}}
\newtcolorbox{remarque}[1][]{envbase,
  before upper={\let\footnote\tcbfootnote \textbf{Remarque\ifblank{#1}{}{\ -- #1}.}\par\setlength{\parindent}{0pt}\setlength{\parskip}{0.5\baselineskip}}}
\newtcolorbox{exemple}[1][]{envbase,
  before upper={\let\footnote\tcbfootnote \textbf{Exemple\ifblank{#1}{}{\ -- #1}.}\par\setlength{\parindent}{0pt}\setlength{\parskip}{0.5\baselineskip}}}
\newtcolorbox{preuve}{envbase,left=0pt,
  before upper={\let\footnote\tcbfootnote \setlength{\parindent}{0pt}\setlength{\parskip}{0.5\baselineskip}\textit{Démonstration.}\ }}

\AfterEndEnvironment{definition}{\tcbflushfn}\AfterEndEnvironment{theoreme}{\tcbflushfn}\AfterEndEnvironment{remarque}{\tcbflushfn}\AfterEndEnvironment{exemple}{\tcbflushfn}\AfterEndEnvironment{preuve}{\tcbflushfn}

% Pas de saut de page avant les chapitres
\patchcmd{\scr@startchapter}{\if@openright\cleardoublepage\else\clearpage\fi}{\par\addpenalty{-300}}{}{\PackageWarning{poly}{patch chapitre echoue}}
\renewcommand*{\chapterpagestyle}{headings}
\RedeclareSectionCommand[beforeskip=1.8\baselineskip,afterskip=1\baselineskip]{chapter}
% Titres de niveau subsubsection ("Question n", "Exercice -- ...") en ligne avec le texte qui suit, moins d'espace autour
\RedeclareSectionCommand[runin=true,beforeskip=0.7\baselineskip,afterskip=0.6em]{subsubsection}
% Titres en ligne des exercices, questions et corrigés : même rendu que le subsubsection ci-dessus, mais sans le
% mécanisme runin de KOMA qui, quand un saut de page suit, fait chevaucher le titre de section suivant et son texte.
\usepackage{needspace}
\newcommand{\runinhead}[1]{\par\needspace{3\baselineskip}\vspace{0.7\baselineskip}\noindent{\normalfont\sffamily\bfseries #1}\hspace{0.6em}\ignorespaces}

% Environnements supplémentaires propres au cours de probabilités (même style que \theoreme)
\newtcolorbox{proposition}[1][]{envbase,borderline west={1.2pt}{0pt}{black},
  before upper={\let\footnote\tcbfootnote \textbf{Proposition\ifblank{#1}{}{\ -- #1}.}\par\setlength{\parindent}{0pt}\setlength{\parskip}{0.5\baselineskip}\itshape}}
\newtcolorbox{corollaire}[1][]{envbase,borderline west={1.2pt}{0pt}{black},
  before upper={\let\footnote\tcbfootnote \textbf{Corollaire\ifblank{#1}{}{\ -- #1}.}\par\setlength{\parindent}{0pt}\setlength{\parskip}{0.5\baselineskip}\itshape}}
\newtcolorbox{lemme}[1][]{envbase,borderline west={1.2pt}{0pt}{black},
  before upper={\let\footnote\tcbfootnote \textbf{Lemme\ifblank{#1}{}{\ -- #1}.}\par\setlength{\parindent}{0pt}\setlength{\parskip}{0.5\baselineskip}\itshape}}
\AfterEndEnvironment{proposition}{\tcbflushfn}\AfterEndEnvironment{corollaire}{\tcbflushfn}\AfterEndEnvironment{lemme}{\tcbflushfn}
\usepackage{longtable,booktabs} % tableaux

% ---- Macros communes à tous les cours ----
\newcommand{\N}{\mathbb{N}}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\Q}{\mathbb{Q}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathbb{C}}
\newcommand{\Rgeq}{\R_{\geq 0}}
\newcommand{\Rg}{\R_{> 0}}

% ---- Corrections des exercices : \correctionstrue pour les inclure, \correctionsfalse pour un poly sans corrigés ----
\newif\ifcorrections
% Par défaut avec corrections. Une version sans corrections s'obtient par :
%   latexmk -pdf -jobname=poly_sans_corrections -usepretex="\def\sanscorrections{1}" poly.tex
\ifdefined\sanscorrections \correctionsfalse \else \correctionstrue \fi
% Lien vers la cible d'une solution : par défaut une ancre \hypertarget ; un poly dont les solutions
% portent seulement un \label peut le redéfinir : \renewcommand{\cdissollink}[2]{\hyperref[#1]{#2}}
\newcommand{\cdissollink}[2]{\hyperlink{#1}{#2}}
% Renvoi vers la solution d'un exercice, affiché seulement si les corrections sont incluses
\newcommand{\solref}[1]{\ifcorrections\ (\protect\cdissollink{#1}{Solution p. \pageref*{#1}}.)\fi}

\counterwithin*{chapter}{part} % la numérotation des chapitres repart à 1 dans chaque partie
\renewcommand{\theHchapter}{\thepart.\arabic{chapter}}
\endinput
